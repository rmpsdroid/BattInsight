<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions for the optional granted-app backend.

      These three are the measured minimum set. Granting them one at a time on Android 16
      showed the platform demanding them in sequence: with none it refuses for lack of
      DUMP; with DUMP it refuses for lack of PACKAGE_USAGE_STATS; with both it refuses
      because dumpsys batterystats passes MATCH_ANY_USER internally and so needs
      INTERACT_ACROSS_USERS. With all three, acquisition works.

      Important properties of these permissions:
        * They are NOT runtime-dialog permissions. No in-app prompt can grant them.
        * Declaring them does NOT make them available. They arrive only through ADB or a
          Shizuku shell session, which is Phase 4 onboarding work.
        * They are entirely optional. The Shizuku backend needs none of them, and the
          application must remain honest about what it can do without them.
        * Holding one is never assumed to mean a capability works. Every capability is
          verified behaviourally before being reported as available.

      Deliberately NOT declared:
        BATTERY_STATS       : measured unnecessary. Acquisition succeeded with it denied,
                              and granting it changed nothing. Both predecessor apps asked
                              users to grant it.
        INTERACT_ACROSS_USERS_FULL : named by the platform alongside INTERACT_ACROSS_USERS
                              but not grantable to an ordinary app, so it is never
                              requested.
        INTERNET            : the application is local first and has no network stack.
        QUERY_ALL_PACKAGES  : store-policy sensitive. UID name resolution is characterised,
                              not solved, in this phase; see docs/data-sources.md.
        READ_LOGS, location, storage : no feature requires them.
    -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/ic_menu_info_details"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BattInsight">

        <!--
          The only exported component, as a launcher entry requires.
          No other component is exported and no FileProvider is declared.
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Required by the Shizuku API so the binder can be delivered to this process.
          It exposes no functionality of ours and is guarded by a permission only the
          system and Shizuku hold.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
